{
  "program": "headwind",
  "version": "1.1",
  "rules": [
    {
      "match": {
        "event_type": "sanctions_delta"
      },
      "ncf": [
        "maintain_supply_chains",
        "transport_by_vessel"
      ]
    },
    {
      "match": {
        "event_type": "export_control_rule"
      },
      "ncf": [
        "maintain_supply_chains",
        "manufacture_equipment"
      ]
    },
    {
      "match": {
        "event_type": "commodity_benchmark"
      },
      "ncf": [
        "provide_food_products",
        "provide_agricultural_products"
      ]
    },
    {
      "match": {
        "event_type": "exchange_rate"
      },
      "ncf": [
        "provide_funding_liquidity",
        "provide_capital_markets"
      ]
    },
    {
      "match": {
        "event_type": "energy_price"
      },
      "ncf": [
        "store_fuel_maintain_reserves",
        "transport_by_pipeline"
      ]
    },
    {
      "match": {
        "event_type": "local_food_price"
      },
      "ncf": [
        "provide_food_products",
        "provide_agricultural_products"
      ]
    }
  ]
}
